[Unit]
Description=Sattva Path — nightly database backup (pg_dump → gzip → email)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/sattva-api
EnvironmentFile=/etc/sattva/db.env
ExecStart=/usr/bin/node backup-db.js
# Match whatever user sattva-api.service runs as; adjust if different.
User=nirupama
StandardOutput=journal
StandardError=journal
